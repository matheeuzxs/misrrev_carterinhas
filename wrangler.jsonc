{
  // Configuração do Worker "misrrev-carterinhas" (Cloudflare Workers + Builds pelo GitHub).
  "name": "misrrev-carterinhas",
  "main": "backend/worker.mjs",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "MEMBROS_DB",
      "database_name": "misrrev-membros",
      "database_id": "1e716747-a08e-4785-b6ff-22e4e4e0e035"
    }
  ],
  "observability": { "enabled": true }
}
